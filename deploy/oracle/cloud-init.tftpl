#cloud-config
package_update: true
package_upgrade: true
packages:
  - git

runcmd:
  - [bash, -lc, "git clone --branch '${app_repository_branch}' --single-branch '${app_repository_url}' /opt/app-cpe"]
  - [bash, -lc, "CPE_REPOSITORY_PATH=/opt/app-cpe bash /opt/app-cpe/scripts/linux/install-vps-worker.sh > /var/log/appcpe-install.log 2>&1"]
  - [bash, -lc, "git clone --branch '${portal_repository_branch}' --single-branch '${portal_repository_url}' /opt/portal-estiba-vlc"]
  - [bash, -lc, "PORTAL_ESTIBA_REPOSITORY_PATH=/opt/portal-estiba-vlc bash /opt/portal-estiba-vlc/scripts/linux/install-contracting-worker.sh > /var/log/appcpe-contracting-install.log 2>&1"]

final_message: "Oracle ARM preparado; los workers permanecen desactivados hasta completar la prueba"
