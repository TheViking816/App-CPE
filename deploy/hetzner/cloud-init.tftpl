#cloud-config
package_update: true
package_upgrade: true
packages:
  - git

runcmd:
  - [bash, -lc, "git clone --branch '${repository_branch}' --single-branch '${repository_url}' /opt/app-cpe"]
  - [bash, -lc, "CPE_REPOSITORY_PATH=/opt/app-cpe bash /opt/app-cpe/scripts/linux/install-vps-worker.sh > /var/log/appcpe-install.log 2>&1"]

final_message: "App CPE VPS base installed"
